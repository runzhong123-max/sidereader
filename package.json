{
  "name": "sidereader",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node --watch server/index.mjs\" \"vite --host 127.0.0.1\"",
    "build": "tsc -b && vite build",
    "start": "node server/index.mjs",
    "test": "node --test server/*.test.mjs",
    "predev": "node scripts/pdf-assets.mjs",
    "prebuild": "node scripts/pdf-assets.mjs",
    "check:architecture": "node scripts/check-architecture.mjs"
  },
  "dependencies": {
    "d3-force": "^3.0.0",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "idb-keyval": "^6.2.2",
    "katex": "0.16.47",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "esbuild": "0.25.12",
    "typescript": "^5.9.0",
    "vite": "^6.3.0"
  }
}
